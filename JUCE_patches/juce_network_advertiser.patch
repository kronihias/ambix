+//==============================================================================
+// The broadcast thread and everything it touches live in a State shared with
+// the thread itself, so the Advertiser can go away without the thread having
+// to. Upstream JUCE ran the thread on the Advertiser and killed it after a
+// 2 s stopThread timeout; the thread is typically inside getaddrinfo() (called
+// by DatagramSocket::write), which on macOS can stall for seconds while the
+// network path is re-evaluated. Cancelling it there leaves a dispatch_once in
+// Network.framework owned by a dead thread, and the next getaddrinfo() in the
+// process traps ("Owner in ulock is unknown"). A detached thread instead
+// finishes its system call and exits.
+struct NetworkServiceDiscovery::Advertiser::State
+{
+    State (const String& serviceTypeUID, int port, RelativeTime interval)
+        : message (serviceTypeUID), broadcastPort (port), minInterval (interval) {}
+
+    void run()
+    {
+        Thread::setCurrentThreadName (SystemStats::getJUCEVersion() + ": Discovery_broadcast");
+
+        if (socket.bindToPort (0))
+        {
+            while (! shouldExit.load())
+            {
+                sendBroadcast();
+                wakeUp.wait ((double) minInterval.inMilliseconds());
+            }
+        }
+        else
+        {
+            jassertfalse;
+        }
+
+        finished.signal();
+    }
+
+    void sendBroadcast();
+
+    CriticalSection lock;
+    XmlElement message;
+    const int broadcastPort;
+    const RelativeTime minInterval;
+    DatagramSocket socket { true };
+
+    std::atomic<bool> shouldExit { false };
+    WaitableEvent wakeUp;
+    WaitableEvent finished { true };
+};
